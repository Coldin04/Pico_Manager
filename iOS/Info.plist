					<string>fb2</string>
					<string>rtf</string>
					<string>doc</string>
					<string>docx</string>
					<string>html</string>
					<string>htm</string>
					<string>kepub</string>
					<string>cbz</string>
					<string>cbr</string>
					<string>djvu</string>
